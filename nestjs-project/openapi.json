  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateUploadDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "Original filename",
            "example": "my_video.mp4",
            "minLength": 1,
            "maxLength": 255
          },
          "content_type": {
            "type": "string",
            "description": "Declared MIME type (must begin with video/)",
            "example": "video/mp4",
            "maxLength": 127
          },
          "size_bytes": {
            "type": "number",
            "description": "File size in bytes (max 10 GB = 10,737,418,240 bytes)",
            "example": 52428800,
            "minimum": 1,
            "maximum": 10737418240
          },
          "file_fingerprint": {
            "type": "string",
            "description": "Client file fingerprint for resume matching across network interruptions",
            "example": "fp_my_video.mp4_52428800_1724900000",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "filename",
          "content_type",
          "size_bytes",
          "file_fingerprint"
        ]
      },
      "UploadSessionResponseDto": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string",
            "example": "a0000000-0000-0000-0000-000000000001"
          },
          "public_id": {
            "type": "string",
            "example": "abc123xyz456_demo78901"
          },
          "canonical_url": {
            "type": "string",
            "example": "/v/abc123xyz456_demo78901"
          },
          "upload_session_id": {
            "type": "string",
            "example": "b0000000-0000-0000-0000-000000000002"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "cancelled",
              "expired"
            ],
            "example": "active"
          },
          "part_size_bytes": {
            "type": "number",
            "example": 16777216
          },
          "expires_at": {
            "type": "string",
            "example": "2026-09-05T20:00:00.000Z"
          }
        },
        "required": [
          "video_id",
          "public_id",
          "canonical_url",
          "upload_session_id",
          "state",
          "part_size_bytes",
          "expires_at"
        ]
      },
      "UploadedPartItemDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "etag": {
            "type": "string",
            "example": "d41d8cd98f00b204e9800998ecf8427e"
          }
        },
        "required": [
          "part_number",
          "etag"
        ]
      },
      "UploadSessionDetailDto": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string",
            "example": "a0000000-0000-0000-0000-000000000001"
          },
          "public_id": {
            "type": "string",
            "example": "abc123xyz456_demo78901"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "cancelled",
              "expired"
            ],
            "example": "active"
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "uploading",
              "uploaded",
              "processing",
              "ready",
              "failed",
              "cancelled"
            ],
            "example": "uploading"
          },
          "part_size_bytes": {
            "type": "number",
            "example": 16777216
          },
          "expected_size_bytes": {
            "type": "number",
            "example": 52428800
          },
          "expires_at": {
            "type": "string",
            "example": "2026-09-05T20:00:00.000Z"
          },
          "uploaded_parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartItemDto"
            }
          }
        },
        "required": [
          "video_id",
          "public_id",
          "state",
          "processing_status",
          "part_size_bytes",
          "expected_size_bytes",
          "expires_at",
          "uploaded_parts"
        ]
      },
      "GetPartUrlsDto": {
        "type": "object",
        "properties": {
          "part_numbers": {
            "description": "Array of 1–100 unique part numbers (each between 1 and 10,000)",
            "example": [
              1,
              2,
              3
            ],
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "part_numbers"
        ]
      },
      "PartUrlItemDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "example": "http://localhost:9000/streamtube-media/videos/..."
          },
          "expires_at": {
            "type": "string",
            "example": "2026-08-29T20:15:00.000Z"
          }
        },
        "required": [
          "part_number",
          "url",
          "expires_at"
        ]
      },
      "PartUrlsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlItemDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompletedPartItemDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "description": "1-indexed part number",
            "example": 1,
            "minimum": 1,
            "maximum": 10000
          },
          "etag": {
            "type": "string",
            "description": "ETag returned by S3/MinIO for the uploaded part",
            "example": "d41d8cd98f00b204e9800998ecf8427e"
          }
        },
        "required": [
          "part_number",
          "etag"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {
          "parts": {
            "description": "Ordered array of completed parts",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompletedPartItemDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompleteUploadResponseDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "abc123xyz456_demo78901"
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "uploading",
              "uploaded",
              "processing",
              "ready",
              "failed",
              "cancelled"
            ],
            "example": "uploaded"
          },
          "processing_version": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "public_id",
          "processing_status",
          "processing_version"
        ]
      },
      "VideoUploadStatusResponseDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "abc123xyz456_demo78901"
          },
          "canonical_url": {
            "type": "string",
            "example": "/v/abc123xyz456_demo78901"
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "uploading",
              "uploaded",
              "processing",
              "ready",
              "failed",
              "cancelled"
            ],
            "example": "ready"
          },
          "duration_seconds": {
            "type": "number",
            "example": 124.55,
            "nullable": true
          },
          "processing_error": {
            "type": "string",
            "example": null,
            "nullable": true
          },
          "thumbnail_available": {
            "type": "boolean",
            "example": true
          },
          "playback_available": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "public_id",
          "canonical_url",
          "processing_status",
          "duration_seconds",
          "processing_error",
          "thumbnail_available",
          "playback_available"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}